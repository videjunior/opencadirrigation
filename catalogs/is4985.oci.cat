{
  "format": "opencadirrigation-catalog",
  "version": 1,
  "id": "is4985",
  "brand": "Generic (IS)",
  "name": "PVC-U pipes by IS 4985",
  "description": "Unplasticized PVC pipes for water supplies of IS 4985:2021, class 1 to 6 (0.25 / 0.4 / 0.6 / 0.8 / 1.0 / 1.25 MPa at 27 °C), dn 20 to 315 mm: minimum walls of its Table 1 (design stress 8.6 MPa); supply reference prices in INR",
  "source": "https://archive.org/details/gov.in.is.4985.2021",
  "license": "CC0-1.0",
  "updated": "2026-11-02",
  "author": "OpenCADIrrigation",
  "currency": "INR",
  "pricesSource": "Maharashtra Jeevan Pradhikaran, State Schedule of Rates 2023-24 (in force from 20 June 2023), section I(II) item 1: ISI-marked rigid PVC pipes to IS 4985 with solvent-cement couplers, working pressure 4 / 6 / 8 / 10 / 12.5 kg/cm² (classes 2 to 6), 63 to 315 mm, supplied to the departmental stores, INR per metre without GST. Published rows used as printed; the other sizes and classes from a least-squares fit to the published rows: price = 209.71 INR/kg × mass per metre (PVC-U 1400 kg/m³).",
  "pricesDate": "2023-06-20",
