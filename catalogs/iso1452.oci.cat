{
  "format": "opencadirrigation-catalog",
  "version": 1,
  "id": "iso1452",
  "brand": "Generic (ISO)",
  "name": "PVC-U pipes by ISO 1452",
  "description": "PVC-U pressure pipes of ISO 1452-2 (EN ISO 1452-2), PN 6 / 8 / 10 / 12.5 / 16 at 25 °C, dn 20 to 315 mm: nominal walls of its Table 2 (MRS 25 MPa, design coefficient 2.5 up to dn 90 and 2.0 above); installed reference prices in EUR",
  "source": "https://www.iso.org/standard/50362.html",
  "license": "CC0-1.0",
  "updated": "2026-11-02",
  "author": "OpenCADIrrigation",
  "currency": "EUR",
  "pricesSource": "Regione Autonoma della Sardegna, Prezzario regionale dell'agricoltura, aggiornamento 2024 (Decreto n. 36 prot. 4817 del 12.12.2024), items F.001 to F.003: PVC-U pipes to UNI EN 1452-2 for irrigation, PN 6 / 10 / 16, supplied and laid with their joints and fittings (trench and bedding excluded), EUR per metre without VAT. Published rows used as printed; the other sizes and classes from a least-squares fit to the published rows: price = 3.52 EUR/m + 6.84 EUR/kg × mass per metre (PVC-U 1400 kg/m³).",
  "pricesDate": "2024-12-12",
  "sources": [
    "ISO 1452-2:2009 - Plastics piping systems for water supply and for buried and above-ground drainage and sewerage under pressure - Unplasticized poly(vinyl chloride) (PVC-U) - Part 2: Pipes",
