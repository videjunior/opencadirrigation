    },
    {
      "src": "../screenshots/phone-780x1688.png",
      "sizes": "780x1688",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "زون وار نتائج کے ساتھ سائز شدہ آبپاشی ڈیزائن"
    }
  ],
  "shortcuts": [
    {
      "name": "انٹرایکٹو ٹیوٹوریل",
      "url": "./?tutorial=1",
      "icons": [
        {
          "src": "../icons/Icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "AI اسسٹنٹ کھولیں",
      "description": "آپ کے ساتھ ڈرائنگ اور ڈیزائن کرنے والا AI اسسٹنٹ",
      "url": "./?ai=1",
      "icons": [
        {
          "src": "../icons/Icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "باغ",
      "description": "ترشاوہ پھلوں پر مائیکرو اسپرنکلر اور انگور پر ڈرپ، پمپ اور فلٹر والا کنواں، ڈھلوان زمین۔",
      "url": "./?design=1",
      "icons": [
        {
          "src": "../icons/Icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "گھریلو باغیچہ",
      "description": "سامنے کے لان پر پاپ اپ اسپرے، پیچھے روٹر اور کیاریوں میں ڈرپ، میٹر اور بیک فلو پریوینٹر کے ساتھ عوامی سپلائی سے۔",
      "url": "./?example=garden",
      "icons": [
        {
          "src": "../icons/Icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "سینٹر پیوٹ",
      "description": "مکئی پر 300 m پیوٹ جسے مرکزی لائن، کنواں اور پمپ سپلائی کرتے ہیں؛ ٹاور، اسپین اور نوزل رپورٹ۔",
      "url": "./?example=pivot",
      "icons": [
        {
          "src": "../icons/Icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "file_handlers": [
    {
      "action": "./?source=file",
      "accept": {
        "application/json": [
          ".oci.json",
          ".json"
        ]
      },
      "icons": [
        {
          "src": "../icons/Icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    },
    {
      "action": "./?source=file",
      "accept": {
        "image/vnd.dxf": [
          ".dxf"
        ],
        "image/vnd.dwg": [
          ".dwg"
        ],
        "image/vnd.dgn": [
          ".dgn"
        ],
        "application/vnd.google-earth.kml+xml": [
          ".kml"
        ],
        "application/vnd.google-earth.kmz": [
          ".kmz"
        ],
        "application/geo+json": [
          ".geojson"
        ],
        "application/gpx+xml": [
          ".gpx"
        ],
        "application/vnd.las": [
          ".las",
          ".laz"
        ]
      },
      "icons": [
        {
          "src": "../icons/Icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  },
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "application/pdf",
            "application/json",
            "application/zip",
            "text/csv",
            "text/plain",
            "application/octet-stream",
            ".oci.json",
            ".json",
            ".dxf",
            ".dwg",
            ".dgn",
            ".kml",
            ".kmz",
            ".geojson",
            ".gpx",
            ".shp",
            ".zip",
            ".las",
            ".laz",
            ".csv",
            ".txt",
            ".pdf"
          ]
        }
      ]
    }
  }
}
