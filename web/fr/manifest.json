{
  "name": "OpenCADIrrigation — CAO pour l’irrigation",
  "short_name": "OpenCADIrrig",
  "id": "/",
  "start_url": "./?source=pwa",
  "scope": "../",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "browser"
  ],
  "orientation": "any",
  "background_color": "#14171B",
  "theme_color": "#0D47A1",
  "lang": "fr",
  "dir": "ltr",
  "description": "Logiciel gratuit et open source de conception d’irrigation en ligne : un assistant IA implante asperseurs et goutte-à-goutte, trace et dimensionne le réseau.",
  "categories": [
    "productivity",
    "utilities",
    "education",
    "business"
  ],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "../icons/Icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "../icons/Icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "../icons/Icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "../icons/Icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "../brand/logo-mark-1024.png",
      "sizes": "1024x1024",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "screenshots": [
    {
      "src": "../screenshots/design-1440x900.png",
      "sizes": "1440x900",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Projet d’irrigation dimensionné avec résultats par zone"
    },
    {
      "src": "../screenshots/phone-780x1688.png",
      "sizes": "780x1688",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Projet d’irrigation dimensionné avec résultats par zone"
    }
  ],
  "shortcuts": [
    {
      "name": "Tutoriel interactif",
      "url": "./?tutorial=1",
      "icons": [
        {
          "src": "../icons/Icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Ouvrir l’assistant IA",
      "description": "Un assistant IA qui dessine et conçoit avec vous",
      "url": "./?ai=1",
      "icons": [
        {
          "src": "../icons/Icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Verger",
      "description": "Micro-aspersion sur agrumes et goutte-à-goutte sur vigne, puits avec pompe et filtre, terrain en pente.",
      "url": "./?design=1",
      "icons": [
        {
          "src": "../icons/Icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Jardin résidentiel",
      "description": "Tuyères escamotables sur la pelouse avant, turbines à l’arrière et goutte-à-goutte dans les massifs, alimentés par le réseau public avec compteur et disconnecteur.",
      "url": "./?example=garden",
      "icons": [
        {
          "src": "../icons/Icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Pivot central",
      "description": "Pivot de 300 m sur maïs alimenté par une conduite principale, un puits et une pompe ; rapport des tours, travées et buses.",
      "url": "./?example=pivot",
      "icons": [
        {
          "src": "../icons/Icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "file_handlers": [
    {
      "action": "./?source=file",
      "accept": {
        "application/json": [
          ".oci.json",
          ".json"
        ]
      },
      "icons": [
        {
          "src": "../icons/Icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    },
    {
      "action": "./?source=file",
      "accept": {
        "image/vnd.dxf": [
          ".dxf"
        ],
        "image/vnd.dwg": [
          ".dwg"
        ],
        "image/vnd.dgn": [
          ".dgn"
        ],
        "application/vnd.google-earth.kml+xml": [
          ".kml"
        ],
        "application/vnd.google-earth.kmz": [
          ".kmz"
        ],
        "application/geo+json": [
          ".geojson"
        ],
        "application/gpx+xml": [
          ".gpx"
        ],
        "application/vnd.las": [
          ".las",
          ".laz"
        ]
      },
      "icons": [
        {
          "src": "../icons/Icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  },
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "application/pdf",
            "application/json",
            "application/zip",
            "text/csv",
            "text/plain",
            "application/octet-stream",
            ".oci.json",
            ".json",
            ".dxf",
            ".dwg",
            ".dgn",
            ".kml",
            ".kmz",
            ".geojson",
            ".gpx",
            ".shp",
            ".zip",
            ".las",
            ".laz",
            ".csv",
            ".txt",
            ".pdf"
          ]
        }
      ]
    }
  }
}
