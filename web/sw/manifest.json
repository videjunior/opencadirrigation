        {
          "src": "../icons/Icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Fungua msaidizi wa AI",
      "description": "Msaidizi wa AI anayechora na kusanifu pamoja nawe",
      "url": "./?ai=1",
      "icons": [
        {
          "src": "../icons/Icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Bustani ya matunda",
      "description": "Vinyunyizio vidogo kwenye michungwa na matone kwenye zabibu, kisima chenye pampu na chujio, ardhi ya mteremko.",
      "url": "./?design=1",
      "icons": [
        {
          "src": "../icons/Icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Bustani ya nyumbani",
      "description": "Vinyunyizio vya pop-up kwenye nyasi za mbele, rota nyuma na matone kwenye vitalu, vikilishwa na mtandao wa maji wenye mita na kizuia mtiririko wa nyuma.",
      "url": "./?example=garden",
      "icons": [
        {
          "src": "../icons/Icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Pivoti ya kati",
      "description": "Pivoti ya m 300 kwenye mahindi inayolishwa na bomba kuu, kisima na pampu; ripoti ya minara, urefu na nozeli.",
      "url": "./?example=pivot",
      "icons": [
        {
          "src": "../icons/Icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "file_handlers": [
    {
      "action": "./?source=file",
      "accept": {
        "application/json": [
          ".oci.json",
          ".json"
        ]
      },
      "icons": [
        {
          "src": "../icons/Icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    },
    {
      "action": "./?source=file",
      "accept": {
        "image/vnd.dxf": [
          ".dxf"
        ],
        "image/vnd.dwg": [
          ".dwg"
        ],
        "image/vnd.dgn": [
          ".dgn"
        ],
        "application/vnd.google-earth.kml+xml": [
          ".kml"
        ],
        "application/vnd.google-earth.kmz": [
          ".kmz"
        ],
        "application/geo+json": [
          ".geojson"
        ],
        "application/gpx+xml": [
          ".gpx"
        ],
        "application/vnd.las": [
          ".las",
          ".laz"
        ]
      },
      "icons": [
        {
          "src": "../icons/Icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  },
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "application/pdf",
            "application/json",
            "application/zip",
            "text/csv",
            "text/plain",
            "application/octet-stream",
            ".oci.json",
            ".json",
            ".dxf",
            ".dwg",
            ".dgn",
            ".kml",
            ".kmz",
            ".geojson",
            ".gpx",
            ".shp",
            ".zip",
            ".las",
            ".laz",
            ".csv",
            ".txt",
            ".pdf"
          ]
        }
      ]
    }
  }
}
