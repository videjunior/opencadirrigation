      "icons": [
        {
          "src": "../icons/Icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "بستان",
      "description": "رشاشات دقيقة على الحمضيات وتنقيط على العنب، بئر بمضخة ومرشح، أرض منحدرة.",
