  "orientation": "any",
  "background_color": "#14171B",
  "theme_color": "#0D47A1",
  "lang": "ar",
  "dir": "rtl",
  "description": "برنامج مجاني ومفتوح المصدر لتصميم الري مع مساعد ذكاء اصطناعي يوزّع الرشاشات والتنقيط ويخطط مسارات الأنابيب ويحدد أقطارها، مباشرةً في متصفحك.",
  "categories": [
    "productivity",
    "utilities",
    "education",
    "business"
  ],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "../icons/Icon-192.png",
