  "file_handlers": [
    {
      "action": "./?source=file",
      "accept": {
        "application/json": [
          ".oci.json",
          ".json"
        ]
      },
      "icons": [
        {
          "src": "../icons/Icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    },
    {
      "action": "./?source=file",
      "accept": {
        "image/vnd.dxf": [
          ".dxf"
        ],
        "image/vnd.dwg": [
          ".dwg"
        ],
        "image/vnd.dgn": [
          ".dgn"
        ],
        "application/vnd.google-earth.kml+xml": [
          ".kml"
        ],
        "application/vnd.google-earth.kmz": [
          ".kmz"
        ],
        "application/geo+json": [
          ".geojson"
        ],
        "application/gpx+xml": [
          ".gpx"
        ],
        "application/vnd.las": [
          ".las",
          ".laz"
        ]
      },
      "icons": [
        {
          "src": "../icons/Icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  },
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "application/pdf",
            "application/json",
            "application/zip",
            "text/csv",
            "text/plain",
            "application/octet-stream",
            ".oci.json",
            ".json",
            ".dxf",
            ".dwg",
            ".dgn",
            ".kml",
            ".kmz",
            ".geojson",
            ".gpx",
            ".shp",
            ".zip",
            ".las",
            ".laz",
            ".csv",
            ".txt",
            ".pdf"
          ]
        }
      ]
    }
  }
