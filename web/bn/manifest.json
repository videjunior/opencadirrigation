  "shortcuts": [
    {
      "name": "ইন্টারঅ্যাক্টিভ টিউটোরিয়াল",
      "url": "./?tutorial=1",
      "icons": [
        {
          "src": "../icons/Icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "AI সহকারী খুলুন",
      "description": "একটি AI সহকারী, যা আপনার সঙ্গে আঁকে ও ডিজাইন করে",
      "url": "./?ai=1",
      "icons": [
        {
          "src": "../icons/Icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "বাগান",
      "description": "লেবুজাতীয়তে মাইক্রো-স্প্রিংকলার ও আঙুরে ড্রিপ, পাম্প ও ফিল্টারসহ কূপ, ঢালু জমি।",
      "url": "./?design=1",
      "icons": [
        {
          "src": "../icons/Icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "বাসার বাগান",
      "description": "সামনের লনে পপ-আপ স্প্রে, পেছনে রোটর ও বেডে ড্রিপ, মিটার ও ব্যাকফ্লো প্রিভেন্টারসহ পৌর সরবরাহ থেকে।",
      "url": "./?example=garden",
      "icons": [
        {
          "src": "../icons/Icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "সেন্টার পিভট",
      "description": "ভুট্টায় 300 m পিভট, মূল লাইন, কূপ ও পাম্প থেকে সরবরাহ; টাওয়ার, স্প্যান ও নজল প্রতিবেদন।",
      "url": "./?example=pivot",
      "icons": [
        {
          "src": "../icons/Icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "file_handlers": [
    {
      "action": "./?source=file",
      "accept": {
        "application/json": [
          ".oci.json",
          ".json"
        ]
      },
      "icons": [
        {
          "src": "../icons/Icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    },
    {
      "action": "./?source=file",
      "accept": {
        "image/vnd.dxf": [
          ".dxf"
        ],
        "image/vnd.dwg": [
          ".dwg"
        ],
        "image/vnd.dgn": [
          ".dgn"
        ],
        "application/vnd.google-earth.kml+xml": [
          ".kml"
        ],
        "application/vnd.google-earth.kmz": [
          ".kmz"
        ],
        "application/geo+json": [
          ".geojson"
        ],
        "application/gpx+xml": [
          ".gpx"
        ],
        "application/vnd.las": [
          ".las",
          ".laz"
        ]
      },
      "icons": [
        {
          "src": "../icons/Icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  },
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "application/pdf",
            "application/json",
            "application/zip",
            "text/csv",
            "text/plain",
            "application/octet-stream",
            ".oci.json",
            ".json",
            ".dxf",
            ".dwg",
            ".dgn",
            ".kml",
            ".kmz",
            ".geojson",
            ".gpx",
            ".shp",
            ".zip",
            ".las",
            ".laz",
            ".csv",
            ".txt",
            ".pdf"
          ]
        }
      ]
    }
  }
