{
  "name": "OpenCADIrrigation — 灌溉设计 CAD",
  "short_name": "OpenCADIrrig",
  "id": "/",
  "start_url": "./?source=pwa",
  "scope": "../",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "browser"
  ],
  "orientation": "any",
  "background_color": "#14171B",
  "theme_color": "#0D47A1",
  "lang": "zh-CN",
  "dir": "ltr",
  "description": "免费开源的灌溉设计软件，内置 AI 助手，直接在浏览器中自动布置喷头和滴灌、布设管道，并完成系统的水力计算与管径选择。",
  "categories": [
    "productivity",
    "utilities",
    "education",
    "business"
  ],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "../icons/Icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "../icons/Icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "../icons/Icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "../icons/Icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "../brand/logo-mark-1024.png",
      "sizes": "1024x1024",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "screenshots": [
    {
      "src": "../screenshots/design-1440x900.png",
      "sizes": "1440x900",
      "type": "image/png",
      "form_factor": "wide",
      "label": "已完成管径计算的灌溉设计及各分区结果"
    },
    {
      "src": "../screenshots/phone-780x1688.png",
      "sizes": "780x1688",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "已完成管径计算的灌溉设计及各分区结果"
    }
  ],
  "shortcuts": [
    {
      "name": "交互式教程",
      "url": "./?tutorial=1",
      "icons": [
        {
          "src": "../icons/Icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "打开 AI 助手",
      "description": "与您一起绘图和设计的 AI 助手",
      "url": "./?ai=1",
      "icons": [
        {
          "src": "../icons/Icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "果园",
      "description": "柑橘采用微喷头、葡萄采用滴灌,水井配水泵和过滤器,坡地。",
      "url": "./?design=1",
      "icons": [
        {
          "src": "../icons/Icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "住宅花园",
      "description": "前院草坪用升降喷头,后院用旋转喷头,花坛用滴灌,由自来水管网供水,配水表和防回流装置。",
      "url": "./?example=garden",
      "icons": [
        {
          "src": "../icons/Icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "中心支轴式喷灌机",
      "description": "玉米地上 300 m 的中心支轴式喷灌机,由干管、水井和水泵供水;塔架、跨段和喷头报告。",
      "url": "./?example=pivot",
      "icons": [
        {
          "src": "../icons/Icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "file_handlers": [
    {
      "action": "./?source=file",
      "accept": {
        "application/json": [
          ".oci.json",
          ".json"
        ]
      },
      "icons": [
        {
          "src": "../icons/Icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    },
    {
      "action": "./?source=file",
      "accept": {
        "image/vnd.dxf": [
          ".dxf"
        ],
        "image/vnd.dwg": [
          ".dwg"
        ],
        "image/vnd.dgn": [
          ".dgn"
        ],
        "application/vnd.google-earth.kml+xml": [
          ".kml"
        ],
        "application/vnd.google-earth.kmz": [
          ".kmz"
        ],
        "application/geo+json": [
          ".geojson"
        ],
        "application/gpx+xml": [
          ".gpx"
        ],
        "application/vnd.las": [
          ".las",
          ".laz"
        ]
      },
      "icons": [
        {
          "src": "../icons/Icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  },
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "application/pdf",
            "application/json",
            "application/zip",
            "text/csv",
            "text/plain",
            "application/octet-stream",
            ".oci.json",
            ".json",
            ".dxf",
            ".dwg",
            ".dgn",
            ".kml",
            ".kmz",
            ".geojson",
            ".gpx",
            ".shp",
            ".zip",
            ".las",
            ".laz",
            ".csv",
            ".txt",
            ".pdf"
          ]
        }
      ]
    }
  }
}
