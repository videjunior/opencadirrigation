.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Local scratch work (probe scripts, experiments): never committed
/tool/scratch/

# npm packages of the end-to-end smoke test (npm ci --prefix tool/e2e)
/tool/e2e/node_modules/

# Generated by `dart run tool/coverage.dart imports` for coverage runs
/test/zz_all_libraries_test.dart

# Diff images of failed golden comparisons
/test/goldens/failures/
