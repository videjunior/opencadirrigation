# Line endings: text files are stored with LF and checked out with LF on every
# platform, whatever core.autocrlf says. Several tests compare generated files
# byte for byte (the site pages, the examples, lib/app/version.dart, the
# shaping fixtures, exported DXF), and a CRLF checkout would fail them.
* text=auto eol=lf

# Test fixtures stay exactly as committed: some are CRLF on purpose (the
# readers must take both line endings) and many are binary.
test/fixtures/** -text

# Binary formats: never converted, never diffed as text.
